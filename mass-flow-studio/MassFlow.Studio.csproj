<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
        <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
        <DisableBuildCompression>true</DisableBuildCompression>
    </PropertyGroup>

    <!-- Exclude sub-project source and generated files from this project's compilation -->
    <ItemGroup>
        <Compile Remove="MassFlow.Studio.Authentication.UI\**" />
        <EmbeddedResource Remove="MassFlow.Studio.Authentication.UI\**" />
        <None Remove="MassFlow.Studio.Authentication.UI\**" />
        <Content Remove="MassFlow.Studio.Authentication.UI\**" />
        <Compile Remove="MassFlow.Studio.Authentication.ElsaIdentity.UI\**" />
        <EmbeddedResource Remove="MassFlow.Studio.Authentication.ElsaIdentity.UI\**" />
        <None Remove="MassFlow.Studio.Authentication.ElsaIdentity.UI\**" />
        <Content Remove="MassFlow.Studio.Authentication.ElsaIdentity.UI\**" />
    </ItemGroup>

    <ItemGroup>
        <!-- MassFlow authentication class libraries -->
        <ProjectReference Include="MassFlow.Studio.Authentication.UI\MassFlow.Studio.Authentication.UI.csproj" />
        <ProjectReference Include="MassFlow.Studio.Authentication.ElsaIdentity.UI\MassFlow.Studio.Authentication.ElsaIdentity.UI.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.8" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="10.0.8" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.8" PrivateAssets="all" />
        <PackageReference Include="Elsa.Studio" Version="3.9.0" />
        <PackageReference Include="Elsa.Studio.Core.BlazorWasm" Version="3.9.0" />
        <PackageReference Include="Elsa.Studio.DomInterop" Version="3.9.0" />
        <PackageReference Include="Elsa.Studio.Shell" Version="3.9.0" />
        <PackageReference Include="Elsa.Studio.Authentication.Abstractions" Version="3.9.0" />
        <PackageReference Include="Elsa.Studio.Authentication.UI" Version="3.9.0" />
        <PackageReference Include="Elsa.Studio.Authentication.Themes" Version="3.9.0" />
        <PackageReference Include="Elsa.Studio.Authentication.ElsaIdentity.BlazorWasm" Version="3.9.0" />
        <PackageReference Include="Elsa.Studio.Authentication.ElsaIdentity.UI" Version="3.9.0" />
        <PackageReference Include="Elsa.Studio.Authentication.OpenIdConnect.BlazorWasm" Version="3.9.0" />
        <PackageReference Include="Elsa.Studio.Login" Version="3.9.0" />
        <PackageReference Include="Elsa.Studio.Login.BlazorWasm" Version="3.9.0" />
        <PackageReference Include="Elsa.Studio.Dashboard" Version="3.9.0" />
        <PackageReference Include="Elsa.Studio.Localization.BlazorWasm" Version="3.9.0" />
        <PackageReference Include="Elsa.Studio.Workflows" Version="3.9.0" />
        <PackageReference Include="Elsa.Studio.Workflows.Designer" Version="3.9.0" />
    </ItemGroup>

    <ItemGroup>
        <ElsaDesignerStaticAsset Include="$(NuGetPackageRoot)elsa.studio.workflows.designer\3.9.0\staticwebassets\**\*" />
    </ItemGroup>

    <Target Name="CopyElsaDesignerStaticAssets" AfterTargets="CopyFilesToOutputDirectory">
        <PropertyGroup>
            <ElsaDesignerOutputPath>$(TargetDir)wwwroot\_content\Elsa.Studio.Workflows.Designer</ElsaDesignerOutputPath>
        </PropertyGroup>
        <MakeDir Directories="$(ElsaDesignerOutputPath)" />
        <Copy SourceFiles="@(ElsaDesignerStaticAsset)"
              DestinationFiles="@(ElsaDesignerStaticAsset->'$(ElsaDesignerOutputPath)\%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
    </Target>

</Project>
